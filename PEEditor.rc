IDD_PAGE_SECTIONS DIALOGEX 0, 0, 409, 249
STYLE DS_SHELLFONT | DS_CONTROL | WS_CHILD
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    CONTROL         "",IDC_SEC_LIST,"SysListView32",0x000D | WS_TABSTOP,2,3,405,155
    LTEXT           "Double-click a value to edit it. Changes are written to the file with Save.",IDC_STATIC,3,162,400,9
    LTEXT           "RVA to file offset",IDC_STATIC,3,180,171,9
    LTEXT           "RVA (hex):",IDC_STATIC,3,196,43,9
    EDITTEXT        IDC_RVA_IN,49,194,74,13,ES_UPPERCASE | ES_AUTOHSCROLL,WS_EX_CLIENTEDGE
    PUSHBUTTON      "Use EntryPoint",IDC_BTN_USE_EP,130,194,80,14,WS_TABSTOP
    LTEXT           "",IDC_RVA_OUT,219,197,186,10,SS_NOPREFIX
    PUSHBUTTON      "Add Section...",IDC_BTN_ADD_SECTION,3,216,100,16,WS_TABSTOP
END

IDD_INPUT DIALOGEX 0, 0, 217, 80
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Edit"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "",IDC_IN_PROMPT,9,9,199,10,SS_NOPREFIX
    EDITTEXT        IDC_IN_EDIT,9,22,199,14,ES_AUTOHSCROLL,WS_EX_CLIENTEDGE
    DEFPUSHBUTTON   "OK",IDOK,98,51,53,15,WS_TABSTOP
    PUSHBUTTON      "Cancel",IDCANCEL,155,51,53,15,WS_TABSTOP
END

IDD_ADD_SECTION DIALOGEX 0, 0, 230, 256
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Add Section"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Section Name:",IDC_STATIC,9,9,100,9
    EDITTEXT        IDC_AS_NAME,115,7,106,13,ES_AUTOHSCROLL,WS_EX_CLIENTEDGE
    LTEXT           "Virtual Size:",IDC_STATIC,9,26,100,9
    EDITTEXT        IDC_AS_VSIZE,115,24,106,13,ES_UPPERCASE | ES_AUTOHSCROLL,WS_EX_CLIENTEDGE
    LTEXT           "Virtual Offset:",IDC_STATIC,9,43,100,9
    EDITTEXT        IDC_AS_VOFFSET,115,41,106,13,ES_UPPERCASE | ES_AUTOHSCROLL,WS_EX_CLIENTEDGE
    LTEXT           "Raw Size:",IDC_STATIC,9,60,100,9
    EDITTEXT        IDC_AS_RSIZE,115,58,106,13,ES_UPPERCASE | ES_AUTOHSCROLL,WS_EX_CLIENTEDGE
    LTEXT           "Raw Offset:",IDC_STATIC,9,77,100,9
    EDITTEXT        IDC_AS_ROFFSET,115,75,106,13,ES_UPPERCASE | ES_AUTOHSCROLL,WS_EX_CLIENTEDGE
    LTEXT           "Characteristic:",IDC_STATIC,9,94,100,9
    EDITTEXT        IDC_AS_CHAR,115,92,106,13,ES_UPPERCASE | ES_AUTOHSCROLL,WS_EX_CLIENTEDGE
    GROUPBOX        "Settings:",IDC_STATIC,9,112,212,86,WS_GROUP
    AUTOCHECKBOX    "Writable",IDC_AS_CHK_WRITABLE,18,127,88,10,WS_TABSTOP
    AUTOCHECKBOX    "Readable",IDC_AS_CHK_READABLE,18,141,88,10,WS_TABSTOP
    AUTOCHECKBOX    "Executable",IDC_AS_CHK_EXECUTABLE,18,155,88,10,WS_TABSTOP
    AUTOCHECKBOX    "Shareable",IDC_AS_CHK_SHAREABLE,18,169,88,10,WS_TABSTOP
    AUTOCHECKBOX    "Code",IDC_AS_CHK_CODE,114,127,98,10,WS_TABSTOP
    AUTOCHECKBOX    "Data Initialised",IDC_AS_CHK_DATAINIT,114,141,98,10,WS_TABSTOP
    AUTOCHECKBOX    "Data UnInitialised",IDC_AS_CHK_DATAUNINIT,114,155,98,10,WS_TABSTOP
    DEFPUSHBUTTON   "Add Section",IDC_AS_BTN_ADD,28,205,80,16,WS_TABSTOP
    PUSHBUTTON      "Cancel",IDCANCEL,122,205,80,16,WS_TABSTOP
    LTEXT           "Adding a section enlarges the file and writes changes immediately.",IDC_STATIC,9,228,212,18
END
