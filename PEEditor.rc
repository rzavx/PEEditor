// PE Editor 1.0 - resources (modern layout: Segoe UI, flat banner, bottom action bar)
#include <windows.h>
#include "resource.h"

IDI_APP ICON "res/icon.ico"

IDD_MAIN DIALOGEX 0, 0, 434, 356
STYLE DS_SHELLFONT | DS_CENTER | WS_MINIMIZEBOX | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_ACCEPTFILES
CAPTION "PE Editor"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "",IDC_BANNER,0,0,434,30,SS_NOPREFIX
    LTEXT           "",IDC_ACCENT,0,30,434,2,SS_NOPREFIX
    LTEXT           "PE Editor",IDC_TITLE,14,4,229,14,SS_NOPREFIX
    LTEXT           "PE32 / PE32+ header editor",IDC_SUBTITLE,14,18,286,9,SS_NOPREFIX
    EDITTEXT        IDC_FILE_PATH,9,38,341,14,ES_AUTOHSCROLL | ES_READONLY,WS_EX_CLIENTEDGE
    PUSHBUTTON      "Open File",IDC_BTN_OPEN,357,38,69,14,BS_OWNERDRAW | WS_TABSTOP
    CONTROL         "",IDC_TAB,"SysTabControl32",WS_TABSTOP | WS_CLIPSIBLINGS,9,60,416,271
    AUTOCHECKBOX    "Create .bak backup",IDC_CHK_BACKUP,11,337,97,12,WS_TABSTOP
    AUTOCHECKBOX    "Fix CheckSum on save",IDC_CHK_CHECKSUM,114,337,109,12,WS_TABSTOP
    PUSHBUTTON      "Exit",IDC_BTN_EXIT,306,335,55,16,BS_OWNERDRAW | WS_TABSTOP
    PUSHBUTTON      "Save",IDC_BTN_SAVE,366,335,59,16,BS_OWNERDRAW | WS_TABSTOP
END

